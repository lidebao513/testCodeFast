# 复制为 .env 后填入真实值（.env 不进 git）
# ===== 被测目标（D-②8：地址与凭据一律外置，禁止硬编码进脚本）=====
RA_TARGET_BASE=http://<host>:<port>

# Web 登录凭据（对应 exec_live.py 的登录表单）
RA_WEB_ACCOUNT=
RA_WEB_PASSWORD=
RA_WEB_OTP=

# 浏览器可执行文件；留空则由 playwright 自动发现（系统 Chrome/Edge → 自带 chromium）
# RA_CHROME_PATH=C:\Users\<you>\AppData\Local\Google\Chrome\Application\chrome.exe

# ===== 平台侧（test-accel）执行鉴权，若走 API 执行也需配置 =====
# RA_ACCOUNT=
# RA_PASSWORD=
# RA_OTP=
# RA_AUTH_TOKEN=
