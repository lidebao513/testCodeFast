# ============================================================================
# testgen-service 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，**不要提交真实密钥**
# ============================================================================

# ---------- 运行 ----------
APP_ENV=dev
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 存储（留空则用项目内 data/ outputs/ 默认值）----------
# DATA_DIR=
# OUTPUT_DIR=
# WORKSPACE_ROOT=
# DB_PATH=

# ---------- 只读工作区 ----------
# 分析完成后是否强制把代码目录置只读
READONLY_STRICT=on

# ---------- 审核门（on = 新产出待人工审核）----------
REVIEW_GATE=off

# ---------- LLM 增强通道（默认关闭：规则引擎必须能独立跑通）----------
LLM_ENHANCE=off
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT=60

# ---------- API 鉴权（留空 = 不校验，仅限内网/开发）----------
AUTH_TOKEN=
