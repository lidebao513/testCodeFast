# ===== testhub 基础设施密钥（LLM 凭据不在此处，入库 AIModelConfig，§11.4）=====
SECRET_KEY=change-me-in-prod
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# 数据库：默认 MySQL 8.0；开发平迁设 DB_ENGINE=sqlite3
DB_ENGINE=mysql
DB_NAME=testhub
DB_USER=testhub
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis（Celery broker / result / cache）
REDIS_URL=redis://127.0.0.1:6379/1

# 被测目标端口池区间（deployment_target 管理，§11.3）
DEPLOY_PORT_POOL_START=8100
DEPLOY_PORT_POOL_END=8200

# 邮件等其余基础设施密钥按 testhub 既定约定补充
