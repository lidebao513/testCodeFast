# ===== LLM 配置 =====
# 提供方：qwen / deepseek
LLM_PROVIDER=qwen

# 通义千问（Qwen）
# 真实 Key 请写入 .env（不进 git）。如为企业/内网端点，改 QWEN_BASE_URL 即可。
QWEN_API_KEY=your_qwen_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash-2026-07-15

# 切换 DeepSeek（可选）
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 功能点提取的 LLM 增强开关：on=AST结果经LLM补全；off=纯 AST（用户拍板：读代码结构为主）
LLM_ENHANCE=on

# ===== 平台 =====
PLATFORM_PORT=8000
# 人工审查门：on=生成的功能点/case 需人工点通过才执行；off=全链路自动跑到最终报告
REVIEW_GATE=on

# ===== 阶段4：测试执行 =====
# 动态 HTTP 探测：on=以真实 HTTP 响应为主判定（需先启动被测服务）；off=仅静态断言
ENABLE_DYNAMIC_PROBE=off

# —— D-②1 鉴权态复用 ——
# 被测系统账号一律走环境变量，**禁止硬编码进任何脚本**
AUTH_AUTO_LOGIN=on
RA_ACCOUNT=
RA_PASSWORD=
RA_OTP=
# 已有 token 时可直接填这里，跳过登录
RA_AUTH_TOKEN=
# 登录端点（留空用默认 /api/v1/auth/unified-login，失败回退 /api/v1/auth/login）
RA_LOGIN_PATH=/api/v1/auth/unified-login
RA_LOGIN_FALLBACK_PATH=/api/v1/auth/login
AUTH_TOKEN_TTL=1800

# —— D-②2 并发执行 ——
# 1 = 串行（崩溃时逐条保底粒度最细）；>1 = 并发（写库仍串行，规避 SQLite 写锁）
EXEC_MAX_WORKERS=4

# —— D-★3 真实浏览器与截图 ——
ENABLE_BROWSER=off
# 留空则自动发现系统 Chrome/Edge，最后才用 playwright 自带 chromium
BROWSER_EXECUTABLE_PATH=
# 前端地址（page 类用例真实渲染用），留空回退被测 base_url
RA_FRONTEND_URL=
BROWSER_TIMEOUT_MS=15000
BROWSER_HEADLESS=on
BROWSER_LAUNCH_TIMEOUT=60
# 截图策略：on_fail=仅失败截图（默认，快）；always=成功也截图
SCREENSHOT_POLICY=on_fail
